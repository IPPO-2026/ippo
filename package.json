{
  "name": "ippo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "npm run typecheck && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:ui:live-contract": "node scripts/smoke-live-ui.mjs",
    "check": "npm run typecheck && npm test && vite build && node scripts/build-pwa.mjs",
    "deploy:demo": "npm run build && wrangler deploy",
    "deploy:live": "npm run build && wrangler deploy --config wrangler.live.jsonc",
    "db:local": "wrangler d1 migrations apply ippo-budget --local --config wrangler.live.jsonc",
    "test:pwa": "node scripts/smoke-pwa.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
